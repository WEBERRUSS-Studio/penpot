# Copy to .env.prod, fill in the values, keep it out of git.
#
#   cp .env.prod.example .env.prod
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Use it with:
#   docker compose -p penpot-prod \
#     -f docker-compose.prod.yaml --env-file .env.prod up -d

## Image tag built by ./build.sh --version <tag>, and the upstream tag of the
## admin console, which has no Dockerfile in this directory.
PENPOT_VERSION=fork
PENPOT_ADMIN_CONSOLE_VERSION=2.18

## Address the instance is reached at. The reverse proxy in front answers this
## name, Penpot itself only listens on the loopback port below. PENPOT_PUBLIC_URI
## has to match what the browser sees, https included, or the frontend loads
## its assets from the wrong place.
PENPOT_PUBLIC_URI=https://penpot.example.com
PENPOT_HTTP_PORT=9001

## Master key for sessions and invitations. One per instance, never reused,
## never changed after the first user logged in.
PENPOT_SECRET_KEY=replace-me

## Postgres password. Also used by the postgres container itself, and it only
## applies while the data volume is still empty.
DB_PASSWORD=replace-me

## SMTP. Email verification is on, so registration does not finish without
## a working SMTP server.
SMTP_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false

## Optional. Defaults are usually fine.
# PENPOT_FLAGS=enable-smtp enable-mcp enable-admin-console
# PENPOT_HTTP_MAX_BODY_SIZE=367001600
# DB_NAME=penpot
# DB_USERNAME=penpot
# SMTP_REPLY_TO=
# VALKEY_MAXMEMORY=128mb
# TELEMETRY_ENABLED=true

## Data volumes. Unset, compose names them <project>_penpot_postgres_data and
## <project>_penpot_assets, so a new project starts with an empty database.
## Set these to the volumes of an existing instance to start on its data.
## List what is on this host: docker volume ls | grep -i penpot
# PENPOT_POSTGRES_VOLUME=penpot-prod_penpot_postgres_data
# PENPOT_ASSETS_VOLUME=penpot-prod_penpot_assets
